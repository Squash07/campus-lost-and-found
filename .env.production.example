# Production settings for InfinityFree (or any shared PHP host without a command line).
# Copy this to ".env" in the uploaded project and fill in the values marked CHANGE_ME.
# Never commit the real .env.

APP_NAME="Campus Lost & Found"
APP_ENV=production
# Generate locally with: php artisan key:generate --show   (then paste the base64:... value here)
APP_KEY=CHANGE_ME
APP_DEBUG=false
# Your site address, with https:// once SSL is active in the InfinityFree control panel
APP_URL=https://CHANGE_ME.infinityfreeapp.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_LEVEL=error

# From InfinityFree control panel > MySQL Databases. The host is NOT localhost.
DB_CONNECTION=mysql
DB_HOST=sqlCHANGE_ME.infinityfree.com
DB_PORT=3306
DB_DATABASE=if0_CHANGE_ME_lostfound
DB_USERNAME=if0_CHANGE_ME
DB_PASSWORD=CHANGE_ME

# File-based drivers: no Redis, no queue workers, no cron on free hosting
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# No mail service on the free plan; password-reset emails are written to the log instead
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# true = show the one-click demo logins (including admin) on /login. Leave false on a public site.
SHOW_DEMO_ACCOUNTS=false
