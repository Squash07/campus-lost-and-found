# Web-root mode (InfinityFree htdocs): serve only public/, hide dotfiles. Max 1 KB on InfinityFree.
Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.+)/$ /$1 [L,R=301]
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ /public/$1 [L]
</IfModule>
<FilesMatch "^\.">
Require all denied
</FilesMatch>
